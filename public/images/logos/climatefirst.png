document.addEventListener("DOMContentLoaded", () => {

  // Safe analytics blocker

  function blockAnalytics(e) {
    if (!e) return;
    e.__analyticsBlocked = true;
    e.stopPropagation();
  }

  document.addEventListener(
    "click",
    function (e) {
      const isLoginUI =
        e.target.closest(".login-panel") ||
        e.target.closest(".log-in-button-custom-code");

      if (!isLoginUI) return;

      setTimeout(() => {
        if (e.stopImmediatePropagation) {
          e.stopImmediatePropagation();
        }
      }, 0);
    },
    true
  );


  // Login panel

  const loginButton = document.querySelector('.log-in-button-custom-code');
  const loginPanel = document.querySelector('.login-panel');

  let panelOpen = false;

  if (loginButton && loginPanel) {

    loginButton.addEventListener("click", (e) => {
      blockAnalytics(e);
      e.preventDefault();

      panelOpen = !panelOpen;
      loginPanel.classList.toggle("is-open", panelOpen);
    });

    loginPanel.addEventListener("click", (e) => {
      if (!panelOpen) return;
      blockAnalytics(e);
    });
  }


  // Dropdown

  const toggle = document.querySelector('[data-login-dropdown="toggle"]');
  const menu = document.querySelector('[data-login-dropdown="menu"]');
  const currentText = document.querySelector('[data-login-current-text="true"]');
  const chevron = document.querySelector('[data-login-dropdown="chevron"]');
  const tabPanes = document.querySelectorAll('[data-login-tab-pane]');

  let isOpen = false;

  function openDropdown() {
    isOpen = true;
    if (menu) menu.style.display = "block";
    if (chevron) chevron.style.transform = "rotate(180deg)";
  }

  function closeDropdown() {
    isOpen = false;
    if (menu) menu.style.display = "none";
    if (chevron) chevron.style.transform = "rotate(0deg)";
  }

  // Toggle dropdown
  if (toggle && menu) {
    toggle.addEventListener("click", (e) => {
      blockAnalytics(e);
      e.preventDefault();

      if (isOpen) {
        closeDropdown();
      } else {
        openDropdown();
      }
    });
  }

  // Prevent menu bubbling
  if (menu) {
    menu.addEventListener("click", (e) => {
      blockAnalytics(e);
    });
  }


  // Option click

  if (loginPanel) {
    loginPanel.addEventListener("click", (e) => {

      const option = e.target.closest('[data-login-dropdown="option"]');
      if (!option) return;

      blockAnalytics(e);
      e.preventDefault();

      const label = option.getAttribute("data-login-label");
      const tabName = option.getAttribute("data-login-tab");

      if (label && currentText) {
        currentText.textContent = label;
      }

      if (tabName) {

        // Update tab buttons
        const tabButtons = document.querySelectorAll('.w-tab-menu [data-w-tab]');
        tabButtons.forEach(btn => btn.classList.remove('w--current'));

        const targetButton = document.querySelector(
          `.w-tab-menu [data-w-tab="${tabName}"]`
        );
        if (targetButton) targetButton.classList.add('w--current');

        // Update panes
        tabPanes.forEach(pane => {
          pane.classList.remove("w--tab-active");
        });

        const targetPane = document.querySelector(
          `[data-login-tab-pane="${tabName}"]`
        );
        if (targetPane) targetPane.classList.add("w--tab-active");
      }

      // Force close after selection
      closeDropdown();
    });
  }


  // Sync label with active tab

  const syncLabelWithActiveTab = () => {
    tabPanes.forEach(pane => {
      if (pane.classList.contains("w--tab-active")) {
        const tabName = pane.getAttribute("data-login-tab-pane");

        if (!currentText) return;

        if (tabName === "Business") {
          currentText.textContent = "Business Online Banking";
        }

        if (tabName === "Personal") {
          currentText.textContent = "Personal Online Banking";
        }
      }
    });

    // Close dropdown after tab change
    closeDropdown();
  };

  const observer = new MutationObserver(syncLabelWithActiveTab);

  tabPanes.forEach(pane => {
    observer.observe(pane, {
      attributes: true,
      attributeFilter: ["class"]
    });
  });

  syncLabelWithActiveTab();

});
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {

  // Personal Login Submit

  const loginForm = document.querySelector('form[name="McMForm"], form#McMForm');

  if (loginForm) {
    loginForm.addEventListener('submit', function () {

      const username = loginForm.querySelector('input[name="uid"]');
      const password = loginForm.querySelector('input[name="pwd"]');

      const usernameFilled = username && username.value.trim() !== '';
      const passwordFilled = password && password.value.trim() !== '';

      if (usernameFilled && passwordFilled) {

        if (typeof gtag === "function") {
          gtag('event', 'personal_login_submit', {
            event_category: 'Login',
            method: 'form'
          });
        }

      }

    });
  }


  // Business Login Button Click

  const businessLinks = document.querySelectorAll('[data-login-business="true"]');

  businessLinks.forEach(link => {
    link.addEventListener('click', function () {

      if (typeof gtag === "function") {
        gtag('event', 'business_login_click', {
          event_category: 'Login',
          method: 'external_link'
        });
      }

    }, true); 

  });

});
</script>

